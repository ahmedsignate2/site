# Copiez ce fichier en .env.local et remplissez les valeurs.

# --- Studio (obligatoire en production) ---
# Clé de signature des sessions : 32 caractères minimum. Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Premier compte propriétaire, créé à la première connexion s'il n'existe encore aucun compte.
# Mot de passe : 10 caractères minimum, lettres et chiffres. Vous pourrez le changer dans le studio.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3847

# --- Paiement Stripe (facultatif : sans clé, les commandes sont simulées) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
