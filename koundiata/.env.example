# Copiez ce fichier en .env.local (ou renseignez ces variables chez votre hébergeur).
# Tout ce qui n'est pas obligatoire peut aussi être saisi dans Studio → Installation.

# --- Obligatoire ---
# Clé de signature des sessions, 32 caractères minimum :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Premier compte propriétaire, créé à la première connexion sur /connexion.
# Mot de passe : 10 caractères minimum, lettres et chiffres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Base de données (obligatoire sur Vercel / Cloudflare / Netlify) ---
# Sans valeur : fichier local data/store.json (serveur unique).
DATABASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3847
# Domaines supplémentaires autorisés (tunnel, www…), séparés par des virgules.
ALLOWED_ORIGINS=
# Taux de TVA affiché sur les factures.
VAT_RATE=20

# --- Paiement Stripe (sans clé : commandes simulées) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-mails automatiques (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# --- Images (Cloudflare R2 ou S3 ; sans valeur : disque local) ---
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
